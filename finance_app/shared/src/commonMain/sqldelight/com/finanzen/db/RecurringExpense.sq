CREATE TABLE RecurringExpense (
    id                INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name              TEXT NOT NULL,
    amountMinor       INTEGER NOT NULL,
    currency          TEXT NOT NULL REFERENCES Currency(code),
    categoryId        INTEGER REFERENCES Category(id),
    accountId         INTEGER REFERENCES Account(id),
    frequency         TEXT NOT NULL,
    intervalCount     INTEGER NOT NULL DEFAULT 1,
    nextChargeDate    INTEGER NOT NULL,
    remindDaysBefore  INTEGER NOT NULL DEFAULT 1,
    active            INTEGER NOT NULL DEFAULT 1
);

selectAll:
SELECT * FROM RecurringExpense ORDER BY nextChargeDate;

selectActive:
SELECT * FROM RecurringExpense WHERE active = 1 ORDER BY nextChargeDate;

selectById:
SELECT * FROM RecurringExpense WHERE id = ?;

insert:
INSERT INTO RecurringExpense(name, amountMinor, currency, categoryId, accountId, frequency, intervalCount, nextChargeDate, remindDaysBefore, active)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertRowId:
SELECT last_insert_rowid();

delete:
DELETE FROM RecurringExpense WHERE id = ?;
