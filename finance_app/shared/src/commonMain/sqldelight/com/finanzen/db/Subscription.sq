CREATE TABLE Subscription (
    id                INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name              TEXT NOT NULL,
    amountMinor       INTEGER NOT NULL,
    currency          TEXT NOT NULL REFERENCES Currency(code),
    categoryId        INTEGER REFERENCES Category(id),
    accountId         INTEGER REFERENCES Account(id),
    frequency         TEXT NOT NULL,                    -- WEEKLY | MONTHLY | YEARLY | CUSTOM
    intervalCount     INTEGER NOT NULL DEFAULT 1,
    nextChargeDate    INTEGER NOT NULL,                 -- epoch day
    remindDaysBefore  INTEGER NOT NULL DEFAULT 1,
    active            INTEGER NOT NULL DEFAULT 1
);

selectAll:
SELECT * FROM Subscription ORDER BY nextChargeDate;

selectActive:
SELECT * FROM Subscription WHERE active = 1 ORDER BY nextChargeDate;

selectById:
SELECT * FROM Subscription WHERE id = ?;

insert:
INSERT INTO Subscription(name, amountMinor, currency, categoryId, accountId, frequency, intervalCount, nextChargeDate, remindDaysBefore, active)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertRowId:
SELECT last_insert_rowid();

update:
UPDATE Subscription
SET name = ?, amountMinor = ?, currency = ?, categoryId = ?, accountId = ?, frequency = ?,
    intervalCount = ?, nextChargeDate = ?, remindDaysBefore = ?, active = ?
WHERE id = ?;

updateNextCharge:
UPDATE Subscription SET nextChargeDate = ? WHERE id = ?;

delete:
DELETE FROM Subscription WHERE id = ?;
