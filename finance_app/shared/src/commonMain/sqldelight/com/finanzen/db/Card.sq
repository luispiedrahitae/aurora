CREATE TABLE Card (
    id                INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    accountId         INTEGER NOT NULL REFERENCES Account(id) ON DELETE CASCADE,
    last4             TEXT NOT NULL,
    network           TEXT NOT NULL,             -- VISA | MASTERCARD | AMEX | OTHER
    creditLimitMinor  INTEGER,                   -- cupo; NULL para débito
    cutoffDay         INTEGER,                   -- día de corte
    dueDay            INTEGER,                   -- día de pago
    interestRate      REAL                       -- tasa de interés anual %; NULL si no aplica
);
-- ponytail: pre-release sin datos productivos → columna añadida sin migración .sqm;
-- reinstalar/limpiar datos en dispositivos de desarrollo. Añadir migración si llega a producción.

selectAll:
SELECT * FROM Card ORDER BY id;

selectByAccount:
SELECT * FROM Card WHERE accountId = ?;

selectById:
SELECT * FROM Card WHERE id = ?;

insert:
INSERT INTO Card(accountId, last4, network, creditLimitMinor, cutoffDay, dueDay, interestRate)
VALUES (?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Card SET accountId = ?, last4 = ?, network = ?, creditLimitMinor = ?, cutoffDay = ?, dueDay = ?, interestRate = ?
WHERE id = ?;

delete:
DELETE FROM Card WHERE id = ?;
