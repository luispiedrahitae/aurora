-- ponytail: tabla nueva sin migración (proyecto pre-release, mismo patrón que InstallmentPlan) —
-- requiere reinstalar/limpiar la BD de desarrollo. categoryId es NOT NULL: siempre se resuelve a la
-- categoría de sistema "Inversiones/Inversión" (ver InvestmentsViewModel.addInvestment y
-- DefaultSeed.kt), no se elige a mano.
CREATE TABLE Investment (
    id                   INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name                 TEXT NOT NULL,
    amountMinor          INTEGER NOT NULL,                 -- monto por aporte (puntual = el monto único)
    currency             TEXT NOT NULL REFERENCES Currency(code),
    accountId            INTEGER REFERENCES Account(id),
    categoryId           INTEGER NOT NULL REFERENCES Category(id),
    periodic             INTEGER NOT NULL DEFAULT 0,
    frequency            TEXT,                             -- null salvo periódica: DAILY | MONTHLY
    intervalCount        INTEGER,
    nextContributionDate INTEGER,                          -- epoch day; null si puntual o CLOSED
    startDate            INTEGER NOT NULL,
    status               TEXT NOT NULL DEFAULT 'OPEN',      -- OPEN | CLOSED | ARCHIVED
    withdrawnAmountMinor INTEGER,
    closedDate           INTEGER,
    yieldMinor           INTEGER                            -- retirado − aportado; puede ser negativo
);

selectOpen:
SELECT * FROM Investment WHERE status = 'OPEN' ORDER BY periodic DESC, nextContributionDate;

selectClosed:
SELECT * FROM Investment WHERE status = 'CLOSED' ORDER BY closedDate DESC;

-- Archivar reutiliza `status` (sin columna nueva: la BD no tiene migraciones). Al restaurar, el
-- estado previo se deduce de closedDate: null = estaba abierta, no-null = estaba cerrada.
selectArchived:
SELECT * FROM Investment WHERE status = 'ARCHIVED' ORDER BY name;

archive:
UPDATE Investment SET status = 'ARCHIVED' WHERE id = ?;

unarchive:
UPDATE Investment SET status = CASE WHEN closedDate IS NULL THEN 'OPEN' ELSE 'CLOSED' END WHERE id = ?;

-- Todas (abiertas, cerradas y archivadas): backup, reportes y limpieza — no deben perder las archivadas.
selectAll:
SELECT * FROM Investment;

selectById:
SELECT * FROM Investment WHERE id = ?;

insert:
INSERT INTO Investment(name, amountMinor, currency, accountId, categoryId, periodic, frequency, intervalCount, nextContributionDate, startDate, status, withdrawnAmountMinor, closedDate, yieldMinor)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'OPEN', NULL, NULL, NULL);

lastInsertRowId:
SELECT last_insert_rowid();

insertFull:
INSERT INTO Investment(name, amountMinor, currency, accountId, categoryId, periodic, frequency, intervalCount, nextContributionDate, startDate, status, withdrawnAmountMinor, closedDate, yieldMinor)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateNextContribution:
UPDATE Investment SET nextContributionDate = ? WHERE id = ?;

update:
UPDATE Investment SET name = ?, amountMinor = ?, currency = ?, accountId = ?, periodic = ?, frequency = ?, intervalCount = ? WHERE id = ?;

close:
UPDATE Investment SET status = 'CLOSED', withdrawnAmountMinor = ?, closedDate = ?, yieldMinor = ?, nextContributionDate = NULL WHERE id = ?;

-- Deshace el cierre: los movimientos (incl. el retiro final) siguen en el historial.
reopen:
UPDATE Investment SET status = 'OPEN', withdrawnAmountMinor = NULL, closedDate = NULL, yieldMinor = NULL, nextContributionDate = ? WHERE id = ?;

delete:
DELETE FROM Investment WHERE id = ?;

deleteByCategory:
DELETE FROM Investment WHERE categoryId = ?;

reassignCategory:
UPDATE Investment SET categoryId = :newCategoryId WHERE categoryId != :newCategoryId;

clearAccount:
UPDATE Investment SET accountId = NULL WHERE accountId = ?;
