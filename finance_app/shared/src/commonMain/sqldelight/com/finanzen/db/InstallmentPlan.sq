-- ponytail: categoryId y settled agregadas sin migración (proyecto pre-release, mismo
-- patrón que Card.interestRate) — reinstala/limpia en dispositivos de desarrollo.
CREATE TABLE InstallmentPlan (
    id                INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    cardId            INTEGER NOT NULL REFERENCES Card(id) ON DELETE CASCADE,
    categoryId        INTEGER REFERENCES Category(id),     -- para replicar la categoría en cada cuota generada
    totalAmountMinor  INTEGER NOT NULL,
    installments      INTEGER NOT NULL,
    interestRate      REAL NOT NULL DEFAULT 0.0,
    startDate         INTEGER NOT NULL,                  -- epoch day
    description       TEXT NOT NULL DEFAULT '',
    settled           INTEGER NOT NULL DEFAULT 0           -- 1 = pagada antes de tiempo, ya no genera más cuotas
);

selectAll:
SELECT * FROM InstallmentPlan ORDER BY startDate DESC;

selectById:
SELECT * FROM InstallmentPlan WHERE id = ?;

selectByCard:
SELECT * FROM InstallmentPlan WHERE cardId = ? ORDER BY startDate DESC;

selectActiveByCard:
SELECT * FROM InstallmentPlan WHERE cardId = ? AND settled = 0 ORDER BY startDate DESC;

insert:
INSERT INTO InstallmentPlan(cardId, categoryId, totalAmountMinor, installments, interestRate, startDate, description, settled)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

lastInsertRowId:
SELECT last_insert_rowid();

update:
UPDATE InstallmentPlan
SET cardId = ?, categoryId = ?, totalAmountMinor = ?, installments = ?, interestRate = ?, startDate = ?, description = ?
WHERE id = ?;

delete:
DELETE FROM InstallmentPlan WHERE id = ?;

rescaleAllTotals:
UPDATE InstallmentPlan SET totalAmountMinor = (totalAmountMinor * ?) / ?;

settleAllByCard:
UPDATE InstallmentPlan SET settled = 1 WHERE cardId = ? AND settled = 0;
