// FinanZen — iOS configuration
//
// Estos valores se referencian desde el target en Xcode (Project → Info → Configurations).
// Cambia TEAM_ID, BUNDLE_ID y APP_NAME para tu cuenta de Apple Developer.

TEAM_ID = TEAMIDXXXXX
BUNDLE_ID = com.finanzen.ios
APP_NAME = FinanZen

// Build settings derivadas
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID)
PRODUCT_NAME = $(APP_NAME)
DEVELOPMENT_TEAM = $(TEAM_ID)

// iOS mínimo
IPHONEOS_DEPLOYMENT_TARGET = 15.0
